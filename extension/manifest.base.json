{
  "manifest_version": 3,
  "name": "Leeward helper",
  "short_name": "Leeward",
  "version": "0.1.0",
  "description": "Keeps the sites on your Leeward Batten down list below deck while you're on watch.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Leeward helper", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "permissions": ["declarativeNetRequestWithHostAccess", "alarms", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["blocked.html", "blocked.css", "blocked.js", "icons/*"], "matches": ["<all_urls>"] }]
}
